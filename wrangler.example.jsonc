{
  "name": "storyframe-studio",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-05",
  "assets": {"directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/media/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "storyframe-studio", "database_id": "REPLACE_AFTER_CREATING_DATABASE"}],
  "r2_buckets": [{"binding": "MEDIA", "bucket_name": "storyframe-studio-media"}]
}
